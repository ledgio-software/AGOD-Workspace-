# Copy to .env.local for local development. Never commit real values.

# Neon Postgres connection string (use the *pooled* string for the deployed app).
# Local alternative: postgresql://postgres:postgres@localhost:5432/agod
DATABASE_URL=

# At least 32 random characters, e.g. `openssl rand -base64 32`. Different per environment.
BETTER_AUTH_SECRET=

# Public base URL of the app, e.g. http://localhost:3000.
# Optional on Vercel: defaults to the production domain / the branch preview URL.
BETTER_AUTH_URL=http://localhost:3000

# Operating timezone used to render dates (timestamps are stored in UTC).
APP_TIMEZONE=Africa/Accra

# Optional error monitoring (Sentry). Leave empty to disable.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Optional GitHub integration (docs/GITHUB_APP.md). All three are needed to turn it on.
GITHUB_APP_ID=
# The app's private key (.pem). Multi-line is fine; "\n" escapes also work.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Optional: skips looking the installation up per repository.
GITHUB_APP_INSTALLATION_ID=

# File attachments. On Vercel, connecting a Blob store adds BLOB_STORE_ID (newer, OIDC) or
# BLOB_READ_WRITE_TOKEN (older) automatically (docs/SETUP.md). Locally, without either, files are
# kept in .data/uploads (or LOCAL_UPLOAD_DIR).
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
LOCAL_UPLOAD_DIR=

# Development seed only (npm run db:seed). Never set in staging/production.
ALLOW_DEV_SEED=
SEED_PASSWORD=

# Optional email reminders over SMTP (docs/EMAIL.md). SMTP_HOST and a sender turn email on.
SMTP_HOST=
# 587 (STARTTLS, default) or 465 (TLS; SMTP_SECURE defaults to true on 465).
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Sender, e.g. "AGOD <reminders@yourdomain.com>". Defaults to SMTP_USER.
EMAIL_FROM=
# Protects the daily job (/api/cron/daily). At least 16 random characters; Vercel Cron sends it.
CRON_SECRET=
# Local testing only (ignored on Vercel): write emails to this folder instead of sending them.
EMAIL_OUTBOX_DIR=

# Optional Google Drive (docs/GOOGLE.md): an OAuth client (Web application) from Google Cloud.
# An Admin then connects the team's Google account on the Integrations page.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Tests only (ignored on Vercel): send every Google call to a local stand-in server.
GOOGLE_API_BASE_FOR_TESTS=

# Phase 23/25: "true" lets anyone join the community (and optionally create a company workspace)
# (docs/COMMUNITY.md). Needs email (SMTP above) for the confirmation link. Leave empty to allow
# invitations only.
ALLOW_SIGNUP=
# Phase 25: the first community organizers (comma-separated emails); organizers can then make others.
COMMUNITY_ORGANIZER_EMAILS=
# Phase 25: chat links shown to members (https), e.g. https://discord.gg/... and https://chat.whatsapp.com/...
COMMUNITY_DISCORD_URL=
COMMUNITY_WHATSAPP_URL=
# Phase 40: AGOD back-office staff who can open /console (comma-separated emails). They see every
# company as a summary, suspend companies, block logins and moderate the community.
PLATFORM_ADMIN_EMAILS=
# Phase 39: only production is indexed by search engines (previews and staging never are). Set to
# "off" to keep production out of search engines too.
SEARCH_INDEXING=

# Phase 26.1: S3-compatible file storage (Cloudflare R2 recommended; docs/STORAGE.md). When all four
# are set, new uploads go there; files saved earlier in Vercel Blob stay readable while
# the Blob store stays connected.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional (R2 uses "auto").
S3_REGION=
